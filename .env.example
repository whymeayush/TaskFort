# Newtonite Operations Hub Environment Configuration (Example)
PORT=5000
NODE_ENV=development
JWT_SECRET=newtonite_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=24h

# MongoDB Connection String
# Leave empty to automatically start the managed MongoDB Replica Set (with WiredTiger engine & transactions)
# Or supply an external cluster URI (e.g. mongodb://localhost:27017/newtonite?replicaSet=rs0)
MONGODB_URI=
