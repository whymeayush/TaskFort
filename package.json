{
  "name": "taskfort-platform",
  "version": "1.0.0",
  "description": "Taskfort — Where work gets done. Operational Work Management Platform",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "build:all": "npm run build --workspace=frontend",
    "start": "node backend/src/server.js",
    "seed": "npm run seed --workspace=backend",
    "test": "npm test --workspace=backend",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=frontend",
    "vercel-build": "npm --prefix frontend install && npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "rollup": "npm:@rollup/wasm-node@^4.65.1"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.65.1"
  },
  "keywords": [
    "taskfort",
    "operations",
    "mern",
    "concurrency",
    "idempotency"
  ],
  "author": "Ayush Tiwari",
  "license": "ISC"
}
